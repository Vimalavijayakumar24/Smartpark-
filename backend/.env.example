# ==========================================
# SMARTPARK AI — ENVIRONMENT CONFIGURATION
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/smartpark

# JWT Authentication Secret
JWT_SECRET=smartpark_production_jwt_secret_change_in_production_2026

# Business Logic Configuration
LATE_ARRIVAL_GRACE_MINUTES=30
LATE_ARRIVAL_CHECK_INTERVAL_MS=30000

# Client Application URL (CORS)
CLIENT_URL=http://localhost:5000

# (Optional) Twilio SMS Provider Credentials
# If omitted, SmartPark automatically runs in Simulated SMS Mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# (Optional) Stripe / Razorpay Payment Gateway Credentials
# If omitted, SmartPark automatically runs in Sandbox Payment Mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
